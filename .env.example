# ---------------------------------------------------------------------------
# Frenyer - Configuracion de entorno
# ---------------------------------------------------------------------------
# IMPORTANTE: las credenciales de Supabase se configuran SOLO en el servidor.
# No uses el prefijo VITE_: Vite inyecta esas variables en el bundle del
# navegador, lo que expone la clave a cualquier visitante.
#
# El servidor las resuelve en este orden:
#   1. data/supabase-credentials.json  (gitignored, formato {"url","anonKey","serviceRoleKey"})
#   2. Variables de entorno del proceso (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY)
#   3. Este archivo .env.local (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY)
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opcional: solo para operaciones administrativas puntuales de Supabase Auth.
# Nunca se usa para consultas de negocio (no debe bypassear las RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Acceso directo al panel cuando Supabase no esta disponible.
# La clave se valida en el servidor y genera una sesion firmada en cookie httpOnly.
# Si se omite, el acceso directo queda deshabilitado.
FRENYER_ACCESS_KEY=
# Secreto para firmar las sesiones locales. Si se omite, se genera y guarda
# en data/.session-secret
FRENYER_SESSION_SECRET=

# Clave publica de Turnstile para los formularios publicos de la tienda.
VITE_TURNSTILE_SITE_KEY=
